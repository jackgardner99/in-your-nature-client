# Base URL the app calls for data. Defaults to /api (same origin).
# In production the portal is on GitHub Pages, which can't proxy, so point this at the backend:
# VITE_API_URL=https://api.getinyournature.com

# Path the portal is served from. Defaults to /portal/.
# VITE_BASE=/portal/

# Dev only: where `npm run dev` forwards /api requests (the FastAPI backend).
# API_PROXY_TARGET=http://localhost:8000
